{
  "name": "zotero-translation-reader",
  "version": "2.4.42",
  "description": "Translate PDF papers in Zotero with original math, figures, tables, saved context, and direct ChatGPT browser login without a CLI.",
  "config": {
    "addonName": "Zotero Translation Reader",
    "addonID": "zotero-paper-translate@kinetic27",
    "addonRef": "zoteroPaperTranslate",
    "prefsPrefix": "extensions.zotero.ZoteroPaperTranslate",
    "addonInstance": "ZoteroPaperTranslate"
  },
  "main": "src/index.ts",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "tsc --noEmit && zotero-plugin build",
    "verify:release": "python3 scripts/verify_release.py",
    "lint": "prettier --write . && eslint . --fix",
    "test": "zotero-plugin test",
    "test:codex-quit": "node test/codexQuit.mjs",
    "update-deps": "npm update --save",
    "test:reader-restart": "node test/readerRestart.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kinetic27/zotero_paper_translate.git"
  },
  "author": "Kinetic27",
  "contributors": [
    {
      "name": "windingwind",
      "url": "https://github.com/windingwind"
    }
  ],
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/Kinetic27/zotero_paper_translate/issues"
  },
  "homepage": "https://github.com/Kinetic27/zotero_paper_translate#readme",
  "dependencies": {
    "franc": "^6.2.0",
    "iso639-js": "^1.1.3",
    "katex": "^0.16.25",
    "zotero-plugin-toolkit": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.16.5",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.3"
  }
}
